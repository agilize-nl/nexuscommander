[Unit]
Description=NexusCommander
After=network-online.target remote-fs.target
Wants=network-online.target remote-fs.target

[Service]
Type=simple
# Run as the account whose files NexusCommander should manage;
# the backend gets exactly this user's file system rights.
User=nexus
Group=nexus
# The checkout is the whole monorepo; the web app lives in apps/web and
# resolves @nexus/ui through the workspace root's node_modules.
WorkingDirectory=/opt/NexusCommander/apps/web
Environment=NODE_ENV=production
EnvironmentFile=-/opt/NexusCommander/apps/web/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

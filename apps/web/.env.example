NC_HOST=127.0.0.1
NC_PORT=3721
NC_ALLOWED_ORIGINS=https://nexuscommander.<tailnet>.ts.net,https://nexuscommander.<lan-domain>
NC_ALLOWED_ORIGIN_PORTS=443
# Host names this server answers to, besides loopback and the hosts named in
# NC_ALLOWED_ORIGINS. Any other Host header is refused (DNS-rebinding guard),
# so add e.g. the LAN address of an NC_ALLOW_REMOTE=1 box here.
# NC_ALLOWED_HOSTS=192.0.2.10
# Zips larger than this are read through 7z instead of in memory (bytes).
# NC_MAX_INMEMORY_ZIP_BYTES=536870912
